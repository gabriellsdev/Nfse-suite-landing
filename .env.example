# NFSe Nacional Suite - Environment Variables Template
# NUNCA insira chaves privadas ou senhas de produção neste arquivo.
# Para configurar variáveis de ambiente locais, copie este arquivo para .env.local

# ID de rastreamento de Analytics (Opcional - Google Analytics 4 ou similar)
# Só é carregado se o visitante consentir expressamente no banner de cookies.
VITE_ANALYTICS_ID=

# URL da API de Releases do GitHub (Padrão para consultar a versão mais recente)
VITE_RELEASE_API_URL=https://api.github.com/repos/gabriellsdev/Nfse-suite-landing/releases/latest
